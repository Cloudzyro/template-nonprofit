---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="wrap nf">
    <h1>This trail washed out</h1>
    <p>The page you're looking for isn't here. It may have moved, or the link has a typo.</p>
    <a class="btn btn-primary" href="/">Back to the home page</a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 1rem;
    justify-items: start;
    min-height: 60vh;
    align-content: center;
    max-width: 40rem;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
  }
  .nf p {
    color: var(--text-2);
  }
</style>
